# This was inserted by `prisma init`:

# Environment variables declared in this file are automatically made available to Prisma.

# See the documentation for more detail: https://pris.ly/d/prisma-schema#using-environment-variables

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server and MongoDB (Preview).

# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="postgresql://user:password@localhost:5432/todo?schema=public"

# Optional. Sentry DSN for the API (@sentry/node). When unset or empty, Sentry
# is not initialized and the process still boots.
# Set this in the Render dashboard — do not commit a real DSN.
SENTRY_DSN=

# Optional pino log level: trace | debug | info | warn | error | fatal.
# Defaults to `debug` outside production and `info` when NODE_ENV=production.
LOG_LEVEL=info

# pretty = colored console (default outside production).
# json = one JSON object per line (default in production, required for Loki).
LOG_FORMAT=pretty
